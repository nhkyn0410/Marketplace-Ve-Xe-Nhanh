# Biến môi trường của Operator OS. Chép file này thành `.env.local` rồi điền giá trị — `.env.local` không
# được commit. Biến có tiền tố NEXT_PUBLIC_ nằm trong mã gửi tới trình duyệt, KHÔNG đặt bí mật ở đây.

# Địa chỉ API. Bỏ trống: dev dùng http://localhost:3000/v1, production dùng /v1 (cùng tên miền).
NEXT_PUBLIC_API_BASE_URL=

# Khóa Goong Maptiles (ADR-027) — khóa HIỂN THỊ bản đồ, tạo ở trang quản lý tài khoản Goong (loại khóa dành
# cho bản đồ, không phải khóa API). Khác với GOONG_API_KEY của API (dùng tính quãng đường). Bỏ trống: mọi khối
# bản đồ ẩn đi, tọa độ nhập tay.
# Đổi giá trị xong phải bật lại máy chủ dev / build lại.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# Gốc web khách hàng (Marketplace), không có `/` cuối — nút "Mở trang nhà xe" ở Hồ sơ & KYC trỏ tới {gốc}/operators/{id}.
# Bỏ trống: dev dùng http://localhost:3001; bản build production thiếu biến thì nút tắt. Đổi giá trị xong phải build lại.
NEXT_PUBLIC_MARKETPLACE_URL=

# Môi trường demo (OQ-21): `true` → hiện cảnh báo "chỉ tải giấy tờ mẫu" ở các ô tải giấy tờ / minh chứng. Production demo
# đặt `true`; bỏ trống ở dev. Đổi giá trị xong phải build lại.
NEXT_PUBLIC_DEMO_MODE=
