generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// Prisma 7: connection URL KHÔNG ở đây nữa — đặt qua driver adapter (PrismaClient)
// + prisma.config.ts (cho Migrate/Studio). Xem ADR-011 (amended Prisma 5 → 7).
datasource db {
  provider = "postgresql"
}

/// Foundation smoke model — chứng minh Prisma migrate + connection.
/// Bảng Platform (KHÔNG operator_id → KHÔNG tenant → KHÔNG RLS, theo DB-PRIN-01).
model HealthCheck {
  id        String   @id @default(uuid())
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

// ════════════════════════════ IAM (TASK-IAM-001) ════════════════════════════
// Identity 3 namespace Account-separate (ADR-017). Passenger = Better Auth native;
// Operator/Platform = bảng domain riêng + verify password (KHÔNG federate).
// RLS (FORCE + policy) đóng đinh ở IAM-003; ở đây chỉ mang `operator_id`.

/// Trạng thái account (FR-IAM-08: khóa / mở khóa / vô hiệu hóa).
enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

/// Trạng thái tenant Operator (tối thiểu v1; OPR-001 mở rộng KYC).
enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

/// Role account Operator-side (v1 chỉ owner; mở rộng sau nếu cần).
enum OperatorRole {
  OPERATOR_OWNER
}

/// Employee role đã chốt v1 (FR-IAM-05, GLOSSARY).
enum EmployeeRole {
  DRIVER
  TICKET_STAFF
  SUPPORT_STAFF
}

/// Loại account sở hữu một tên đăng nhập trong namespace Operator.
/// Registry dùng enum riêng để DB cấm Owner và Employee trùng username trong cùng tenant.
enum OperatorLoginAccountType {
  OPERATOR
  EMPLOYEE
}

/// Role account Platform-side (RBAC 8-role, ADR-017).
enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

// ──────────────── Passenger identity — Better Auth quản lý ────────────────
// 4 bảng lõi theo schema chính thức Better Auth. Giữ tên model đúng default
// (User/Session/Account/Verification) → adapter Prisma khỏi cần config modelName;
// chỉ `@@map` đổi tên bảng DB. Better Auth tự sinh `id` (String).

model User {
  id            String        @id
  name          String?
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  /// Admin khóa hành khách (FR-IAM-08) — app kiểm khi cấp phiên; Better Auth không dùng cột này.
  status        AccountStatus @default(ACTIVE)
  lockedReason  String?       @map("locked_reason")
  lockedAt      DateTime?     @map("locked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ──────────────── Operator tenant root (tối thiểu) ────────────────
/// Tenant root tối thiểu để login/seed; OPR-001 mở rộng KYC/profile.
/// `operator_id` = id bảng này (RLS key, IAM-003).
model OperatorProfile {
  id              String         @id @default(uuid())
  operatorSlug    String         @unique @map("operator_slug")
  displayName     String         @map("display_name")
  status          OperatorStatus @default(ACTIVE)
  /// Lý do Admin tạm khóa (bắt buộc khi `SUSPENDED` — CHECK `operator_profiles_suspension_reason`).
  suspendedReason String?        @map("suspended_reason")
  suspendedAt     DateTime?      @map("suspended_at")
  /// Thông tin pháp lý / công khai chép từ hồ sơ đăng ký lúc duyệt; nhà xe sửa được phần công khai (OPR-001b).
  legalName       String?        @map("legal_name")
  taxCode         String?        @map("tax_code")
  hotline         String?
  publicEmail     String?        @map("public_email")
  address         String?
  description     String?
  approvedAt      DateTime?      @map("approved_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  operatorAccounts   OperatorAccount[]
  employeeAccounts   EmployeeAccount[]
  operatorLoginNames OperatorLoginName[]
  seatMaps           SeatMap[]
  stopPoints         StopPoint[]
  stopPointProposals StopPointProposal[]
  routes             Route[]
  vehicles           Vehicle[]
  trips              Trip[]
  fares              Fare[]
  application        OperatorApplication?
  kycDocuments       KycDocument[]
  bankAccounts       BankAccount[]
  policyVersions     PolicyVersion[]
  commissionRules    CommissionRule[]

  @@unique([id, operatorSlug])
  @@map("operator_profiles")
}

/// Registry namespace đăng nhập dùng chung cho Owner và Employee trong một Operator.
/// Trigger DB đồng bộ bảng này; application không tự ghi trực tiếp.
model OperatorLoginName {
  operatorId  String                   @map("operator_id")
  username    String
  accountType OperatorLoginAccountType @map("account_type")
  accountId   String                   @map("account_id")
  createdAt   DateTime                 @default(now()) @map("created_at")

  operator         OperatorProfile   @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operatorAccounts OperatorAccount[]
  employeeAccounts EmployeeAccount[]

  @@id([operatorId, username])
  @@unique([accountType, accountId])
  @@map("operator_login_names")
}

// ──────────────── Operator-side identity (custom, Account-separate) ────────────────
/// Login Operator owner: `{operatorSlug}/{username}` + password (closed enrollment).
model OperatorAccount {
  id                         String        @id @default(uuid())
  operatorId                 String        @map("operator_id")
  operatorSlug               String        @map("operator_slug")
  // CHECK `operator_accounts_username_not_employee_prefix`: cấm tiền tố `nv.` của Employee (TASK-IAM-006).
  username                   String
  contactEmail               String?       @map("contact_email")
  passwordHash               String        @map("password_hash")
  authEpoch                  Int           @default(0) @map("auth_epoch")
  version                    Int           @default(0)
  credentialDeliveryPending  Boolean       @default(false) @map("credential_delivery_pending")
  passwordChangeRequired     Boolean       @default(false) @map("password_change_required")
  temporaryPasswordExpiresAt DateTime?     @map("temporary_password_expires_at")
  role                       OperatorRole  @default(OPERATOR_OWNER)
  status                     AccountStatus @default(ACTIVE)
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  // RESTRICT, không CASCADE (TASK-IAM-003): hành động cascade của FK chạy với quyền owner và BỎ QUA
  // RLS (kể cả FORCE) — xoá/đổi id một operator_profiles sẽ quét luôn account của tenant đó.
  operator  OperatorProfile   @relation(fields: [operatorId, operatorSlug], references: [id, operatorSlug], onDelete: Restrict, onUpdate: Restrict)
  loginName OperatorLoginName @relation(fields: [operatorId, username], references: [operatorId, username], onDelete: NoAction, onUpdate: NoAction)

  @@unique([operatorSlug, username])
  @@index([operatorId])
  @@map("operator_accounts")
}

/// Login Employee trong tenant: username + password (operator-owned).
model EmployeeAccount {
  id                         String        @id @default(uuid())
  operatorId                 String        @map("operator_id")
  // CHECK `employee_accounts_username_employee_prefix`: `nv.` + 2–61 ký tự [a-z0-9._-] (TASK-IAM-006).
  username                   String
  contactEmail               String?       @map("contact_email")
  passwordHash               String        @map("password_hash")
  authEpoch                  Int           @default(0) @map("auth_epoch")
  version                    Int           @default(0)
  credentialDeliveryPending  Boolean       @default(false) @map("credential_delivery_pending")
  passwordChangeRequired     Boolean       @default(false) @map("password_change_required")
  temporaryPasswordExpiresAt DateTime?     @map("temporary_password_expires_at")
  role                       EmployeeRole
  status                     AccountStatus @default(ACTIVE)
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  // RESTRICT, không CASCADE (TASK-IAM-003): hành động cascade của FK chạy với quyền owner và BỎ QUA
  // RLS (kể cả FORCE) — xoá/đổi id một operator_profiles sẽ quét luôn account của tenant đó.
  operator  OperatorProfile   @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  loginName OperatorLoginName @relation(fields: [operatorId, username], references: [operatorId, username], onDelete: NoAction, onUpdate: NoAction)

  @@unique([operatorId, username])
  @@map("employee_accounts")
}

// ──────────────── Platform-side identity (custom) ────────────────
/// Login Platform: `platform/{username}` + password (closed enrollment, KHÔNG OAuth).
model PlatformAccount {
  id                         String        @id @default(uuid())
  username                   String        @unique
  passwordHash               String        @map("password_hash")
  role                       PlatformRole
  status                     AccountStatus @default(ACTIVE)
  /// Email nội bộ nhận mật khẩu tạm (tài khoản do Admin cấp — ADM-03d).
  contactEmail               String?       @unique @map("contact_email")
  authEpoch                  Int           @default(0) @map("auth_epoch")
  credentialDeliveryPending  Boolean       @default(false) @map("credential_delivery_pending")
  passwordChangeRequired     Boolean       @default(false) @map("password_change_required")
  temporaryPasswordExpiresAt DateTime?     @map("temporary_password_expires_at")
  lockedReason               String?       @map("locked_reason")
  lockedAt                   DateTime?     @map("locked_at")
  /// `platform_accounts.id` của Admin đã cấp tài khoản; `null` = seed.
  createdBy                  String?       @map("created_by")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  @@map("platform_accounts")
}

// ════════════════════════ IAM — Session (TASK-IAM-002) ════════════════════════

/// Chủ thể của một phiên. **4 giá trị**, KHÔNG phải 3 `scope` của JWT:
/// scope `operator` gộp cả `operator_accounts` lẫn `employee_accounts`, nên nếu
/// chỉ lưu scope thì revoke-all sẽ đá nhầm người (quyết định Q2, 16/09/2026).

enum SubjectType {
  PASSENGER
  OPERATOR
  EMPLOYEE
  PLATFORM
}

/// Vì sao phiên bị thu hồi (FR-IAM-16).
enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  ACCOUNT_LOCKED
  PASSWORD_RESET
  ADMIN_FORCE
  /// Phiên của role bắt buộc MFA nhưng cấp trước TASK-IAM-004 (không có `mfa_verified_at`).
  MFA_REQUIRED
}

/// Một phiên đăng nhập = một refresh token đang sống (ADR-017, DB §7).
/// Account-separate ⇒ chủ thể nằm ở 4 bảng khác nhau nên **không có FK nào trỏ
/// đủ cả 4**; dùng cặp `subject_type` + `subject_id`.
/// Row sau khi rotate **giữ lại, không xoá** — nó chính là thứ duy nhất cho phép
/// phát hiện reuse. Dọn dẹp là việc của job retention, không phải của refresh.

model AuthSession {
  id               String               @id @default(uuid()) // = claim `sid` trong JWT
  subjectType      SubjectType          @map("subject_type")
  subjectId        String               @map("subject_id")
  userRef          String               @map("user_ref")
  familyId         String               @map("family_id") // 1 login = 1 family; rotation Giữ nguyên
  /// SHA-256 của token opaque. KHÔNG scrypt: token là random 32-byte (entropy đã
  /// đầy, không cần làm chậm brute-force), và mỗi lần refresh phải tra O(1).
  refreshTokenHash String               @unique @map("refresh_token_hash")
  authEpoch        Int                  @default(0) @map("auth_epoch")
  issuedAt         DateTime             @default(now()) @map("issued_at")
  expiresAt        DateTime             @map("expires_at")
  lastUsedAt       DateTime?            @map("last_used_at")
  rotatedAt        DateTime?            @map("rotated_at")
  replacedById     String?              @unique @map("replaced_by_id")
  revokedAt        DateTime?            @map("revoked_at")
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  mfaVerifiedAt    DateTime?            @map("mfa_verified_at")
  /// Tenant cho RLS ở IAM-003, và để revoke hàng loạt khi Operator bị suspend.
  operatorId       String?              @map("operator_id")
  ip               String?
  userAgent        String?              @map("user_agent")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([userRef, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([operatorId])
  @@map("auth_sessions")
}

// ════════════════════════════ IAM — MFA (TASK-IAM-004) ════════════════════════════

/// Thông tin TOTP do app quản lý cho một chủ thể. Quan hệ chủ thể là đa hình nên
/// không có FK đến ba bảng account; ràng buộc PASSENGER được đặt trong migration.
model MfaCredential {
  id               String          @id @default(uuid())
  subjectType      SubjectType     @map("subject_type")
  subjectId        String          @map("subject_id")
  secretCiphertext String          @map("secret_ciphertext")
  lastTotpCounter  BigInt?         @map("last_totp_counter")
  enabledAt        DateTime        @default(now()) @map("enabled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  backupCodes      MfaBackupCode[]

  @@unique([subjectType, subjectId])
  @@map("mfa_credentials")
}

/// Backup code chỉ lưu hash; `used_at` được set atomically khi tiêu thụ.
model MfaBackupCode {
  id           String        @id @default(uuid())
  credentialId String        @map("credential_id")
  codeHash     String        @map("code_hash")
  usedAt       DateTime?     @map("used_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, codeHash])
  @@index([credentialId, usedAt])
  @@map("mfa_backup_codes")
}

// ════════════════════════════ Catalog (TASK-CAT-001) ════════════════════════════
// Dữ liệu chuẩn Platform (DB §5.2): KHÔNG `operator_id`. RLS: ai cũng đọc, chỉ scope platform/system
// được ghi (migration `add_catalog`). Không xoá cứng — vô hiệu hoá bằng `status` (UC-24 A1).
// FK RESTRICT, không CASCADE: cascade chạy quyền owner và bỏ qua RLS.

/// Trạng thái catalog item; API công khai chỉ trả `ACTIVE`.
enum CatalogStatus {
  ACTIVE
  INACTIVE
}

/// Loại điểm đón / trả chuẩn (AS-15, DP-08).
enum StopPointType {
  BUS_STATION
  OFFICE
  REST_STOP
  PICKUP_POINT
}

/// Tỉnh / thành phố - 'code' theo danh mục hành chính chình thức.
model Province {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  wards Ward[]

  @@map("provinces")
}

/// Phường / xã thuộc một tỉnh — `code` theo danh mục hành chính chính thức.
model Ward {
  id         String        @id @default(uuid())
  provinceId String        @map("province_id")
  code       String        @unique
  name       String
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  province           Province            @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stopPoints         StopPointCatalog[]
  privateStopPoints  StopPoint[]
  stopPointProposals StopPointProposal[]

  // Đích của FK ghép từ stop point: DB tự chặn phường không thuộc tỉnh (UC-24 A2).
  @@unique([id, provinceId])
  @@index([provinceId])
  @@map("wards")
}

/// Điểm đón / trả chuẩn Platform; tách khỏi `stop_points` riêng của Operator (TRN-002).
/// Toạ độ `double precision` + CHECK phạm vi trong migration; chưa PostGIS.
model StopPointCatalog {
  id          String        @id @default(uuid())
  name        String
  type        StopPointType
  address     String
  provinceId  String        @map("province_id")
  wardId      String        @map("ward_id")
  latitude    Float
  longitude   Float
  description String?
  /// Căn cứ công bố của cơ quan quản lý (BR-38): bắt buộc với bến xe / điểm dừng đón trả, tối đa 300 ký tự (CHECK).
  legalBasis  String?       @map("legal_basis")
  status      CatalogStatus @default(ACTIVE)
  /// Cột DO DATABASE SINH (tên + địa chỉ, chữ thường, bỏ dấu) để tìm không dấu — KHÔNG ghi từ code.
  searchText  String?       @map("search_text")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ward       Ward                @relation(fields: [wardId, provinceId], references: [id, provinceId], onDelete: Restrict, onUpdate: Restrict)
  routeStops RouteStop[]
  tripStops  TripStop[]
  proposals  StopPointProposal[]

  @@index([provinceId, status])
  @@index([provinceId, type, status])
  @@index([wardId])
  @@map("stop_points_catalog")
}

/// Dạng chỗ của loại xe (BR-77).
enum VehicleForm {
  SEATER
  SLEEPER
  CABIN
}

/// Hạng xe (BR-77). Limousine là hạng, không phải dạng chỗ.
enum VehicleClass {
  STANDARD
  LIMOUSINE
}

/// Loại phương tiện chuẩn: mỗi dòng mang dạng chỗ + hạng xe (BR-77, TASK-TRN-010).
/// Không đặt default cho `form` / `class`: mọi đường ghi phải khai rõ cả hai.
model VehicleType {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  form        VehicleForm
  class       VehicleClass
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  vehicles  Vehicle[]
  fareRules FareRule[]

  @@map("vehicle_types")
}

/// Tiện ích chuẩn gắn cho phương tiện (TRN-001).
model Amenity {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  vehicleAmenities VehicleAmenity[]

  @@map("amenities")
}

// ════════════════════════════ Transport — Vehicle (TASK-TRN-001) ════════════════════════════
// Operator-owned: mọi bảng có `operator_id` + ENABLE/FORCE RLS `tenant_isolation` (migration
// `add_vehicle`). FK ghép `(…, operator_id)` để DB chặn gắn SeatMap/ghế/tiện ích xe của tenant khác.
// FK RESTRICT, không CASCADE: cascade chạy quyền owner và bỏ qua RLS.

/// Trạng thái vận hành xe (FR-OPS-02); chỉ `ACTIVE` mới được gán chuyến (TRN-003).
enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

/// Loại chỗ trong sơ đồ (BR-78). Chỗ đôi (`*_DOUBLE`) chứa tối đa hai hành khách, còn lại một.
enum SeatType {
  SEAT
  BED
  BED_DOUBLE
  CABIN
  CABIN_DOUBLE
}

/// Sơ đồ ghế do nhà xe tự cấu hình, dùng làm mẫu chung cho nhiều xe (quyết định Q1).
model SeatMap {
  id         String   @id @default(uuid())
  operatorId String   @map("operator_id")
  name       String
  /// `{ decks: [{ deck, rows, columns }] }` — Zod kiểm ở biên API.
  layout     Json
  seatCount  Int      @map("seat_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seats    Seat[]
  vehicles Vehicle[]

  @@unique([operatorId, name])
  @@unique([id, operatorId])
  @@map("seat_maps")
}

/// Một ghế/giường trong SeatMap; TRN-003 sinh TripSeat từ đây.
model Seat {
  id         String   @id @default(uuid())
  operatorId String   @map("operator_id")
  seatMapId  String   @map("seat_map_id")
  code       String
  deck       Int
  row        Int
  column     Int
  type       SeatType

  seatMap SeatMap @relation(fields: [seatMapId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([seatMapId, code])
  @@unique([seatMapId, deck, row, column])
  @@map("seats")
}

/// Phương tiện của nhà xe (FR-OPS-01..02).
model Vehicle {
  id            String        @id @default(uuid())
  operatorId    String        @map("operator_id")
  /// Đã chuẩn hoá: chữ hoa, bỏ khoảng trắng / `.` / `-`.
  plateNumber   String        @map("plate_number")
  vehicleTypeId String        @map("vehicle_type_id")
  seatMapId     String?       @map("seat_map_id")
  status        VehicleStatus @default(ACTIVE)
  description   String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  operator    OperatorProfile  @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vehicleType VehicleType      @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seatMap     SeatMap?         @relation(fields: [seatMapId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  amenities   VehicleAmenity[]
  images      VehicleImage[]
  trips       Trip[]

  @@unique([operatorId, plateNumber])
  @@unique([id, operatorId])
  @@index([operatorId, status])
  @@map("vehicles")
}

/// Tiện ích catalog gắn cho một xe (bảng nối, quyết định Q2).
model VehicleAmenity {
  vehicleId  String @map("vehicle_id")
  amenityId  String @map("amenity_id")
  operatorId String @map("operator_id")

  vehicle Vehicle @relation(fields: [vehicleId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([vehicleId, amenityId])
  @@map("vehicle_amenities")
}

/// Ảnh công khai của xe (BR-76, TASK-TRN-009): `objectKey` trỏ object ở kho public (ADR-018), `position` nhỏ
/// nhất là ảnh đại diện. Giới hạn 8 ảnh / xe, loại và dung lượng file giữ bằng CHECK ở migration.
model VehicleImage {
  id          String   @id @default(uuid())
  operatorId  String   @map("operator_id")
  vehicleId   String   @map("vehicle_id")
  objectKey   String   @unique @map("object_key")
  position    Int
  caption     String?
  sizeBytes   Int      @map("size_bytes")
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([vehicleId, position])
  @@index([operatorId])
  @@map("vehicle_images")
}

// ════════════════════════════ Transport — Route & StopPoint (TASK-TRN-002) ════════════════════════════
// Operator-owned + RLS (migration `add_route`). Đề xuất StopPoint: RLS chỉ cho tenant tạo/ghi `PENDING`
// và sửa bản `REJECTED` — Operator không tự duyệt được; Admin (scope platform) duyệt ở ADM-001.

/// Trạng thái điểm đón/trả riêng của nhà xe; `INACTIVE` không gắn mới vào route.
enum StopPointStatus {
  ACTIVE
  INACTIVE
  /// Admin khóa điểm sai lệch / vi phạm (BR-81); nhà xe không tự đặt và không tự gỡ (RLS).
  SUSPENDED
}

/// Trạng thái đề xuất đưa điểm vào catalog chuẩn (Admin duyệt ở ADM-001).
enum StopPointProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Trạng thái route; `INACTIVE` không dùng để tạo chuyến mới (TRN-003).
enum RouteStatus {
  ACTIVE
  INACTIVE
}

/// Vai trò điểm trong route — suy ra từ vị trí (đầu / giữa / cuối).
enum RouteStopRole {
  ORIGIN
  INTERMEDIATE
  DESTINATION
}

/// Nguồn số liệu khoảng cách/thời gian: Goong thật hay ước lượng đường chim bay (dev, Q8).
enum RoutingMetricsSource {
  GOONG
  ESTIMATE
}

/// Điểm dừng riêng của một nhà xe — dùng ngay trong route của tenant (Q1). Chỉ loại `OFFICE` (văn phòng /
/// điểm trung chuyển) hoặc `REST_STOP` (CHECK trong migration, BR-38); bến xe và điểm dừng đón trả chỉ có ở
/// danh mục dùng chung.
model StopPoint {
  id               String          @id @default(uuid())
  operatorId       String          @map("operator_id")
  name             String
  type             StopPointType
  address          String
  provinceId       String          @map("province_id")
  wardId           String          @map("ward_id")
  latitude         Float
  longitude        Float
  description      String?
  status           StopPointStatus @default(ACTIVE)
  /// Có giá trị khi và chỉ khi `status = SUSPENDED` (CHECK trong migration).
  suspensionReason String?         @map("suspension_reason")
  /// Cột DO DATABASE SINH (tên + địa chỉ, chữ thường, bỏ dấu) để tìm không dấu — KHÔNG ghi từ code.
  searchText       String?         @map("search_text")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  operator   OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ward       Ward            @relation(fields: [wardId, provinceId], references: [id, provinceId], onDelete: Restrict, onUpdate: Restrict)
  routeStops RouteStop[]
  tripStops  TripStop[]

  @@unique([operatorId, name])
  @@unique([id, operatorId])
  @@index([operatorId, status])
  @@map("stop_points")
}

/// Đề xuất của nhà xe đưa một điểm vào catalog chuẩn (FR-OPS-05, UC-13 bước 7–8).
model StopPointProposal {
  id                 String                  @id @default(uuid())
  operatorId         String                  @map("operator_id")
  name               String
  type               StopPointType
  address            String
  provinceId         String                  @map("province_id")
  wardId             String                  @map("ward_id")
  latitude           Float
  longitude          Float
  description        String?
  /// Căn cứ công bố của cơ quan quản lý (BR-38): bắt buộc, tối đa 300 ký tự.
  legalBasis         String                  @map("legal_basis")
  status             StopPointProposalStatus @default(PENDING)
  rejectionReason    String?                 @map("rejection_reason")
  /// Điểm catalog Admin tạo/link khi duyệt (ADM-001).
  catalogStopPointId String?                 @map("catalog_stop_point_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  operator         OperatorProfile   @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ward             Ward              @relation(fields: [wardId, provinceId], references: [id, provinceId], onDelete: Restrict, onUpdate: Restrict)
  catalogStopPoint StopPointCatalog? @relation(fields: [catalogStopPointId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([operatorId, status])
  @@index([status])
  @@map("stop_point_proposals")
}

/// Tuyến của nhà xe (FR-OPS-04); tổng khoảng cách/thời gian = tổng các chặng đã lưu.
model Route {
  id                   String               @id @default(uuid())
  operatorId           String               @map("operator_id")
  name                 String
  status               RouteStatus          @default(ACTIVE)
  note                 String?
  totalDistanceMeters  Int                  @map("total_distance_meters")
  totalDurationSeconds Int                  @map("total_duration_seconds")
  metricsSource        RoutingMetricsSource @map("metrics_source")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stops    RouteStop[]
  trips    Trip[]
  fare     Fare?

  @@unique([operatorId, name])
  @@unique([id, operatorId])
  @@index([operatorId, status])
  @@map("routes")
}

/// Một điểm theo thứ tự trong route: tham chiếu catalog HOẶC điểm riêng (CHECK trong migration).
model RouteStop {
  id                          String        @id @default(uuid())
  operatorId                  String        @map("operator_id")
  routeId                     String        @map("route_id")
  sequence                    Int
  role                        RouteStopRole
  catalogStopPointId          String?       @map("catalog_stop_point_id")
  stopPointId                 String?       @map("stop_point_id")
  note                        String?
  /// Cho đón / cho trả tại điểm này (BR-79): điểm đầu chỉ đón, điểm cuối chỉ trả (CHECK trong migration);
  /// phần phụ thuộc loại điểm (trạm dừng nghỉ không đón, không trả) kiểm ở service.
  allowPickup                 Boolean       @map("allow_pickup")
  allowDropoff                Boolean       @map("allow_dropoff")
  /// Toạ độ đã dùng để tính số liệu chặng — so với toạ độ hiện tại của điểm để biết khi nào phải tính lại.
  latitude                    Float
  longitude                   Float
  /// Từ điểm liền trước; điểm đầu để trống (CHECK trong migration).
  distanceMetersFromPrevious  Int?          @map("distance_meters_from_previous")
  durationSecondsFromPrevious Int?          @map("duration_seconds_from_previous")

  route            Route             @relation(fields: [routeId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  catalogStopPoint StopPointCatalog? @relation(fields: [catalogStopPointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stopPoint        StopPoint?        @relation(fields: [stopPointId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([routeId, sequence])
  @@unique([routeId, catalogStopPointId])
  @@unique([routeId, stopPointId])
  @@index([catalogStopPointId])
  @@index([stopPointId])
  @@map("route_stops")
}

// ════════════════════════════ Trip & Inventory — Trip (TASK-TRN-003) ════════════════════════════
// Operator-owned + RLS (migration `add_trip`). Chống một xe chạy hai chuyến chồng giờ bằng ràng buộc
// EXCLUDE (btree_gist) trong migration — Prisma không mô tả được, xem migration.sql.

/// Trạng thái chuyến (SRS §17.3, GLOSSARY). TRN-003 chỉ ghi `DRAFT`; mở bán/khoá/huỷ ở TRN-006.
enum TripStatus {
  DRAFT
  OPEN_FOR_SALE
  SOLD_OUT
  LOCKED
  BOARDING
  DEPARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  INCIDENT
}

/// Trạng thái ghế theo chuyến (SRS §17.4, GLOSSARY). TRN-003 chỉ sinh `AVAILABLE`.
enum TripSeatStatus {
  AVAILABLE
  HOLDING
  BOOKED
  CHECKED_IN
  BLOCKED
}

/// Chuyến cụ thể của một route vào một ngày giờ, có thể chưa gắn xe khi còn `DRAFT` (FR-OPS-06, UC-14).
model Trip {
  id                      String     @id @default(uuid())
  operatorId              String     @map("operator_id")
  routeId                 String     @map("route_id")
  vehicleId               String?    @map("vehicle_id")
  /// Giờ đi / giờ đến dự kiến (UTC). Xe bận trong `[departure_at, arrival_at)`.
  departureAt             DateTime   @map("departure_at")
  arrivalAt               DateTime   @map("arrival_at")
  status                  TripStatus @default(DRAFT)
  /// Số phút trước giờ khởi hành thì ngừng bán online (AS-20, TRN-006): 0–1440 (CHECK ở migration).
  onlineSaleCutoffMinutes Int        @default(60) @map("online_sale_cutoff_minutes")
  /// Lý do lần đổi trạng thái gần nhất (hủy bắt buộc — CHECK ở migration).
  statusReason            String?    @map("status_reason")
  note                    String?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  route    Route           @relation(fields: [routeId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  vehicle  Vehicle?        @relation(fields: [vehicleId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  stops    TripStop[]
  seats    TripSeat[]

  @@unique([id, operatorId])
  @@index([operatorId, departureAt])
  @@index([routeId])
  // Không có btree riêng cho `vehicle_id`: index GiST của EXCLUDE (partial, bắt đầu bằng `operator_id`) chỉ
  // phục vụ một phần; truy vấn theo xe hiện lọc thêm `operator_id` + giờ đi. Thêm index khi đo được tải.
  @@map("trips")
}

/// Điểm dừng của chuyến: chép từ RouteStop lúc tạo/sửa chuyến, kèm giờ dự kiến tại điểm.
model TripStop {
  id                 String        @id @default(uuid())
  operatorId         String        @map("operator_id")
  tripId             String        @map("trip_id")
  sequence           Int
  role               RouteStopRole
  catalogStopPointId String?       @map("catalog_stop_point_id")
  stopPointId        String?       @map("stop_point_id")
  note               String?
  /// Chép từ RouteStop (BR-79); CHECK theo vai trò điểm đầu / điểm cuối trong migration.
  allowPickup        Boolean       @map("allow_pickup")
  allowDropoff       Boolean       @map("allow_dropoff")
  plannedAt          DateTime      @map("planned_at")

  trip             Trip              @relation(fields: [tripId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  catalogStopPoint StopPointCatalog? @relation(fields: [catalogStopPointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stopPoint        StopPoint?        @relation(fields: [stopPointId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tripId, sequence])
  @@index([catalogStopPointId])
  @@index([stopPointId])
  @@map("trip_stops")
}

/// Ghế của chuyến: bản chụp Seat của SeatMap lúc gắn xe; tham chiếu theo `seat_code` (DB §7).
model TripSeat {
  id         String         @id @default(uuid())
  operatorId String         @map("operator_id")
  tripId     String         @map("trip_id")
  seatCode   String         @map("seat_code")
  deck       Int
  row        Int
  column     Int
  type       SeatType
  status     TripSeatStatus @default(AVAILABLE)

  trip Trip @relation(fields: [tripId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tripId, seatCode])
  @@index([tripId, status])
  @@map("trip_seats")
}

// ════════════════════════════ Trip & Inventory — Fare (TASK-TRN-005) ════════════════════════════
// Operator-owned + RLS (migration `add_fare`). Mỗi tuyến một bảng giá (Q1 = PA1); rule theo loại xe × loại chỗ ×
// khung giờ khởi hành. Chống hai rule cùng phạm vi bằng EXCLUDE trong migration (Prisma không mô tả được).
// Lịch sử giá (BR-40) = Mongo `audit_event` (Q4), không có bảng lịch sử.

/// Trạng thái bảng giá; `INACTIVE` → ghế của chuyến trên tuyến không có giá (không mở bán được, TRN-006).
enum FareStatus {
  ACTIVE
  INACTIVE
}

/// Bảng giá của một tuyến (FR-OPS-08, OQ-08).
model Fare {
  id         String     @id @default(uuid())
  operatorId String     @map("operator_id")
  routeId    String     @map("route_id")
  status     FareStatus @default(ACTIVE)
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  route    Route           @relation(fields: [routeId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  rules    FareRule[]

  // Mỗi tuyến một bảng giá: route thuộc đúng một tenant (FK ghép) nên unique này tương đương unique `route_id`.
  @@unique([routeId, operatorId])
  @@unique([id, operatorId])
  @@index([operatorId, status])
  @@map("fares")
}

/// Một giá tuyệt đối (VND) cho loại xe × loại chỗ × khung giờ khởi hành; `null` = mọi loại / không khung giờ.
model FareRule {
  id            String    @id @default(uuid())
  operatorId    String    @map("operator_id")
  fareId        String    @map("fare_id")
  vehicleTypeId String?   @map("vehicle_type_id")
  seatType      SeatType? @map("seat_type")
  /// Khung giờ khởi hành `[valid_from, valid_to)` (UTC); cả hai trống = giá thường.
  validFrom     DateTime? @map("valid_from")
  validTo       DateTime? @map("valid_to")
  /// VND, số nguyên đồng 0–100.000.000 (CHECK trong migration).
  price         BigInt

  fare        Fare         @relation(fields: [fareId, operatorId], references: [id, operatorId], onDelete: Restrict, onUpdate: Restrict)
  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fareId])
  @@index([vehicleTypeId])
  @@map("fare_rules")
}

// ── Operator onboarding (TASK-OPR-001, BR-75, LLD §6.11) ──

enum OperatorApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFO
  APPROVED
  REJECTED
}

/// Bộ giấy tờ KYC bắt buộc v1 (OQ-19). Tài khoản nhận tiền là trường của hồ sơ, không phải giấy tờ.
enum OperatorApplicationDocumentType {
  BUSINESS_REGISTRATION
  TRANSPORT_LICENSE
  REPRESENTATIVE_AUTHORIZATION
}

/// Hồ sơ đăng ký nhà xe, nộp TRƯỚC khi có tài khoản (BR-75). Dữ liệu cấp Platform: chưa có tenant, RLS chỉ cho
/// scope `platform` / `system`. `operatorId` chỉ có khi `APPROVED` (mỗi hồ sơ tối đa một Operator).
model OperatorApplication {
  id                     String                    @id @default(uuid())
  applicationCode        String                    @unique @map("application_code")
  status                 OperatorApplicationStatus @default(DRAFT)
  operatorName           String                    @map("operator_name")
  contactName            String                    @map("contact_name")
  contactEmail           String                    @map("contact_email")
  contactEmailVerifiedAt DateTime?                 @map("contact_email_verified_at")
  termsAcceptedAt        DateTime                  @map("terms_accepted_at")
  legalName              String?                   @map("legal_name")
  taxCode                String?                   @map("tax_code")
  hotline                String?
  address                String?
  displayName            String?                   @map("display_name")
  description            String?
  bankName               String?                   @map("bank_name")
  bankAccountNumber      String?                   @map("bank_account_number")
  bankAccountHolder      String?                   @map("bank_account_holder")
  /// Lý do Admin ghi khi yêu cầu bổ sung / từ chối (UC-23).
  reviewNote             String?                   @map("review_note")
  submittedAt            DateTime?                 @map("submitted_at")
  /// Lần ra quyết định gần nhất của Admin (bổ sung / từ chối / duyệt) — UC-23 bước 5.
  reviewedAt             DateTime?                 @map("reviewed_at")
  /// `platform_accounts.id` của Admin ra quyết định gần nhất.
  reviewedBy             String?                   @map("reviewed_by")
  /// `Idempotency-Key` của lần duyệt (API §8); chỉ có khi `APPROVED`.
  approvalIdempotencyKey String?                   @map("approval_idempotency_key")
  operatorId             String?                   @unique @map("operator_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  operator     OperatorProfile?                 @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documents    OperatorApplicationDocument[]
  accessTokens OperatorApplicationAccessToken[]

  @@index([status, submittedAt])
  @@index([contactEmail])
  @@index([taxCode])
  @@index([bankAccountNumber])
  @@map("operator_applications")
}

/// Giấy tờ KYC của hồ sơ: chỉ metadata + khóa object ở kho private (ADR-018), không lưu file. Mỗi loại một bản.
model OperatorApplicationDocument {
  id            String                          @id @default(uuid())
  applicationId String                          @map("application_id")
  type          OperatorApplicationDocumentType
  objectKey     String                          @unique @map("object_key")
  fileName      String                          @map("file_name")
  contentType   String                          @map("content_type")
  sizeBytes     Int                             @map("size_bytes")
  uploadedAt    DateTime                        @default(now()) @map("uploaded_at")

  application OperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([applicationId, type])
  @@map("operator_application_documents")
}

/// Link bảo mật của hồ sơ: chỉ lưu SHA-256 của token (BR-75, Security §5). Cấp link mới thu hồi link cũ.
model OperatorApplicationAccessToken {
  id            String    @id @default(uuid())
  applicationId String    @map("application_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  application OperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([applicationId, revokedAt])
  @@map("operator_application_access_tokens")
}

// ════════════════════════════ Content — Bài viết (TASK-CNT-001) ════════════════════════════
// Dữ liệu cấp Platform, KHÔNG `operator_id`. RLS (migration `add_articles`): ai cũng đọc, chỉ scope
// platform / system ghi — API công khai tự lọc bài `PUBLISHED` đã tới giờ xuất bản (BR-74).

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Chuyên mục bài viết (FR-ADM-19). Ngừng dùng = `INACTIVE`, không chọn được cho bài mới.
model ArticleCategory {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  displayOrder Int           @default(0) @map("display_order")
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  articles Article[]

  @@map("article_categories")
}

/// Bài tin tức / cẩm nang (FR-ADM-18). Nội dung Markdown; ảnh bìa là khóa object ở kho công khai.
model Article {
  id              String        @id @default(uuid())
  categoryId      String        @map("category_id")
  title           String
  slug            String        @unique
  summary         String
  contentMarkdown String        @map("content_markdown")
  coverImageKey   String?       @map("cover_image_key")
  featured        Boolean       @default(false)
  status          ArticleStatus @default(DRAFT)
  /// Thời điểm xuất bản; có thể ở tương lai (hẹn giờ) — API công khai chỉ trả bài đã tới giờ.
  publishedAt     DateTime?     @map("published_at")
  viewCount       Int           @default(0) @map("view_count")
  /// Tài khoản Platform tạo / sửa lần cuối.
  createdBy       String        @map("created_by")
  updatedBy       String        @map("updated_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@map("articles")
}

// ════════════════════════════ Operator — Hồ sơ & KYC sau duyệt (TASK-OPR-001b) ════════════════════════════
// Tenant + RLS (migration `operator_profile_kyc`). Chép từ hồ sơ đăng ký lúc Admin duyệt.

/// Giấy tờ KYC hiện hành của nhà xe (kho private, ADR-018) — mỗi loại một bản; tải bản mới thay bản cũ.
model KycDocument {
  id          String                          @id @default(uuid())
  operatorId  String                          @map("operator_id")
  type        OperatorApplicationDocumentType
  objectKey   String                          @unique @map("object_key")
  fileName    String                          @map("file_name")
  contentType String                          @map("content_type")
  sizeBytes   Int                             @map("size_bytes")
  uploadedAt  DateTime                        @default(now()) @map("uploaded_at")
  /// Tài khoản chủ nhà xe tải bản này; `null` = chép từ hồ sơ đăng ký.
  uploadedBy  String?                         @map("uploaded_by")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operatorId, type])
  @@map("kyc_documents")
}

enum BankAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  REPLACED
}

/// Tài khoản nhận tiền (payout, ADR-022). Mỗi nhà xe tối đa một `VERIFIED` và một `PENDING` (index một phần trong
/// migration — Prisma không khai được). Đổi tài khoản = yêu cầu `PENDING` chờ Admin xác minh.
model BankAccount {
  id            String            @id @default(uuid())
  operatorId    String            @map("operator_id")
  bankName      String            @map("bank_name")
  accountNumber String            @map("account_number")
  accountHolder String            @map("account_holder")
  status        BankAccountStatus @default(PENDING)
  changeReason  String?           @map("change_reason")
  reviewNote    String?           @map("review_note")
  requestedBy   String?           @map("requested_by")
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  operator OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([operatorId, status])
  @@map("bank_accounts")
}

// ── Chính sách nền tảng (TASK-ADM-001 phần chính sách + khung giá; FR-ADM-06..09, UC-25, AS-23) ──

enum PolicyType {
  CANCELLATION
  SEAT_HOLD
  PAYOUT
}

enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// Trạng thái của mức hoa hồng / khung giá: hủy = không bao giờ áp dụng nữa (giữ dòng để tra lịch sử).
enum PolicyRuleStatus {
  ACTIVE
  CANCELLED
}

/// Một phiên bản chính sách theo loại + phạm vi (`operatorId` null = mặc định nền tảng). Đã kích hoạt thì không sửa;
/// phiên bản mới có hiệu lực từ `effectiveFrom`, booking cũ giữ snapshot (BR-07). Unique (loại, phạm vi, số phiên bản)
/// và (loại, phạm vi, thời điểm hiệu lực) của bản đã kích hoạt nằm trong migration (biểu thức COALESCE).
model PolicyVersion {
  id            String              @id @default(uuid())
  type          PolicyType
  operatorId    String?             @map("operator_id")
  version       Int
  status        PolicyVersionStatus @default(DRAFT)
  /// Nội dung theo loại — Zod kiểm ở `policy/dto` (mốc hoàn tiền / phút giữ chỗ / chu kỳ chi trả).
  rules         Json
  description   String?
  changeReason  String?             @map("change_reason")
  effectiveFrom DateTime?           @map("effective_from")
  createdBy     String?             @map("created_by")
  publishedBy   String?             @map("published_by")
  publishedAt   DateTime?           @map("published_at")
  cancelledBy   String?             @map("cancelled_by")
  cancelledAt   DateTime?           @map("cancelled_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  operator OperatorProfile? @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([type, operatorId, status])
  @@map("policy_versions")
}

/// Hoa hồng theo phần vạn (`rateBps` 500 = 5%) trên giá vé bán thành công (BR-31); `operatorId` null = mức mặc định.
model CommissionRule {
  id            String           @id @default(uuid())
  operatorId    String?          @map("operator_id")
  rateBps       Int              @map("rate_bps")
  effectiveFrom DateTime         @map("effective_from")
  /// Không gồm; `null` = không thời hạn.
  effectiveTo   DateTime?        @map("effective_to")
  status        PolicyRuleStatus @default(ACTIVE)
  reason        String
  createdBy     String?          @map("created_by")
  cancelledBy   String?          @map("cancelled_by")
  cancelledAt   DateTime?        @map("cancelled_at")
  cancelReason  String?          @map("cancel_reason")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  operator OperatorProfile? @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([operatorId, status])
  @@map("commission_rules")
}

/// Khung giá trần / sàn mỗi chỗ cho một dịp (FR-ADM-09, OQ-17) — chỉ cảnh báo nhà xe, không chặn lưu / mở bán.
model FareBand {
  id            String           @id @default(uuid())
  name          String
  /// VND (BIGINT); ít nhất một trong hai.
  minPrice      BigInt?          @map("min_price")
  maxPrice      BigInt?          @map("max_price")
  effectiveFrom DateTime         @map("effective_from")
  /// Không gồm.
  effectiveTo   DateTime         @map("effective_to")
  /// Nội dung cảnh báo hiện cho nhà xe.
  message       String
  reason        String
  status        PolicyRuleStatus @default(ACTIVE)
  createdBy     String?          @map("created_by")
  cancelledBy   String?          @map("cancelled_by")
  cancelledAt   DateTime?        @map("cancelled_at")
  cancelReason  String?          @map("cancel_reason")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([status, effectiveTo])
  @@map("fare_bands")
}
