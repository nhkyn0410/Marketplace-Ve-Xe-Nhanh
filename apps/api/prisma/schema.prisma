generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Foundation smoke model — chứng minh Prisma migrate + connection.
/// Bảng Platform (KHÔNG operator_id → KHÔNG tenant → KHÔNG RLS, theo DB-PRIN-01).
model HealthCheck {
  id        String   @id @default(uuid())
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
