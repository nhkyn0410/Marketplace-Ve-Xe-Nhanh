# ─────────────────────────────────────────────────────────────────────────────
# Cấu trúc env 2 phần:
#   1) `.env`                                  → chỉ chọn môi trường: NODE_ENV=development|production
#   2) `.env.development` / `.env.production`  → giá trị theo môi trường
# Loader: đọc NODE_ENV (từ `.env` hoặc shell/Render) → nạp `.env.{NODE_ENV}`.
# Precedence (cao→thấp): env thật (shell/Render) > `.env` > `.env.{NODE_ENV}`.
#
# Setup local: tạo `.env` (NODE_ENV=development) + copy phần giá trị dưới → `.env.development`.
# Production THẬT trên Render lấy từ env group + secrets (sync:false) — KHÔNG commit giá trị.
# ─────────────────────────────────────────────────────────────────────────────

# ── đặt ở `.env` ─────────────────────────────────────────────
NODE_ENV="development"

# ── đặt ở `.env.development` / `.env.production` ──────────────
PORT="3000"
# Local/direct = 0. Render public path hiện tại = 3 (app -> Render -> Cloudflare -> client).
TRUST_PROXY_HOPS="0"

# Postgres (Prisma) — operational DB
DATABASE_URL="postgresql://vexenhanh:vexenhanh_dev@localhost:5432/vexenhanh_dev?schema=public"

# Mongo audit (Mongoose, cluster RIÊNG — ADR-011)
MONGODB_AUDIT_URI="mongodb://vexenhanh:vexenhanh_dev@localhost:27017/vexenhanh_audit?authSource=admin"
# Mongo audit production hardening (admin URI chỉ dùng để chạy script, không dùng app runtime)
MONGODB_ADMIN_URI="mongodb://admin:change_me@localhost:27017/admin?authSource=admin"
MONGODB_AUDIT_DB="vexenhanh_audit"
MONGODB_AUDIT_APP_USER="vexenhanh_audit_app"
MONGODB_AUDIT_APP_PASSWORD="change_me"

# Redis / BullMQ (ADR-015 / ADR-016 — FND-004)
REDIS_URL="redis://localhost:6379"
BULLMQ_PREFIX="vexenhanh"
BULL_BOARD_TOKEN="change-me-local"

# Logging (Pino — ADR-026 / FND-006)
LOG_LEVEL="info"

# Observability (ADR-026 — FND-006)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
OTEL_SERVICE_NAME="vexenhanh-api"

# IAM / Better Auth (ADR-017 — TASK-IAM-001)
# Production: BETTER_AUTH_SECRET phải lấy từ secret store; BETTER_AUTH_URL phải là HTTPS public URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Danh sách origin phân tách bằng dấu phẩy; production phải khai báo tường minh.
AUTH_ALLOWED_CALLBACK_ORIGINS="http://localhost:3000,vexenhanh://,vexenhanh-operator://"

# JWT access RS256 (private key: PKCS#8 PEM raw hoặc base64; production bắt buộc)
# Dev để trống private key sẽ sinh keypair ephemeral, token mất hiệu lực sau khi restart.
JWT_ACCESS_PRIVATE_KEY=""
# Reserved cho verifier/JWKS sau này; TokenService hiện chưa đọc biến này.
JWT_ACCESS_PUBLIC_KEY=""
JWT_ACCESS_TTL_SECONDS="900"
JWT_ISSUER="vexenhanh"

# OAuth Passenger — v1 chỉ bật Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Deferred v1.x: chưa được wire ở v1 hiện tại.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Email OTP — dev để trống API key dùng ConsoleEmailNotifier; production bắt buộc Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@vexenhanh.com"

# IAM seed — CHỈ local/dev; điền trước khi chạy `pnpm --filter @vexenhanh/api db:seed`.
# Không đặt các biến SEED_* trong production/Render.
SEED_PLATFORM_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
SEED_EMPLOYEE_PASSWORD=""
