# ─────────────────────────────────────────────────────────────────────────────
# Cấu trúc env 2 phần:
#   1) `.env`                                  → chỉ chọn môi trường: NODE_ENV=development|production
#   2) `.env.development` / `.env.production`  → giá trị theo môi trường
# Loader: đọc NODE_ENV (từ `.env` hoặc shell/Render) → nạp `.env.{NODE_ENV}`.
# Precedence (cao→thấp): env thật (shell/Render) > `.env` > `.env.{NODE_ENV}`.
#
# Setup local: tạo `.env` (NODE_ENV=development) + copy phần giá trị dưới → `.env.development`.
# Production THẬT trên Render lấy từ env group + secrets (sync:false) — KHÔNG commit giá trị.
# ─────────────────────────────────────────────────────────────────────────────

# ── đặt ở `.env` ─────────────────────────────────────────────
NODE_ENV="development"

# ── đặt ở `.env.development` / `.env.production` ──────────────
PORT="3000"
# Local/direct = 0. Render public path hiện tại = 3 (app -> Render -> Cloudflare -> client).
TRUST_PROXY_HOPS="0"

# Postgres (Prisma) — operational DB. HAI role (TASK-IAM-003, DB-PRIN-01):
# - DATABASE_URL: role APP (`vexenhanh_app`) — mật khẩu riêng (khác owner), NOSUPERUSER, NOBYPASSRLS,
#   chỉ CRUD. Superuser/owner bỏ qua
#   RLS kể cả khi FORCE → app chạy bằng owner thì RLS vô hiệu. Tạo role: `pnpm --filter @vexenhanh/api db:app-role`.
# - MIGRATION_DATABASE_URL: owner — CHỈ cho migrate/seed/db:app-role. KHÔNG đưa vào env service API/worker.
# - Supabase Shared Session Pooler (cổng 5432): username kết nối là `<role>.<PROJECT_REF>`; script tự
#   dùng tên role thật khi chạy SQL; URL bắt buộc `sslmode=verify-full`, password app ngẫu nhiên >=32
#   ký tự ASCII.
DATABASE_URL="postgresql://vexenhanh_app:vexenhanh_app_dev@localhost:5432/vexenhanh_dev?schema=public"
MIGRATION_DATABASE_URL="postgresql://vexenhanh:vexenhanh_dev@localhost:5432/vexenhanh_dev?schema=public"

# Mongo audit (Mongoose, cluster RIÊNG — ADR-011)
MONGODB_AUDIT_URI="mongodb://vexenhanh:vexenhanh_dev@localhost:27017/vexenhanh_audit?authSource=admin"
# Mongo audit production hardening (admin URI chỉ dùng để chạy script, không dùng app runtime)
MONGODB_ADMIN_URI="mongodb://admin:change_me@localhost:27017/admin?authSource=admin"
MONGODB_AUDIT_DB="vexenhanh_audit"
MONGODB_AUDIT_APP_USER="vexenhanh_audit_app"
MONGODB_AUDIT_APP_PASSWORD="change_me"

# Redis / BullMQ (ADR-015 / ADR-016 — FND-004)
REDIS_URL="redis://localhost:6379"
BULLMQ_PREFIX="vexenhanh"
BULL_BOARD_TOKEN="change-me-local"

# Logging (Pino — ADR-026 / FND-006)
LOG_LEVEL="info"

# Observability (ADR-026 — FND-006)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
OTEL_SERVICE_NAME="vexenhanh-api"

# IAM / Better Auth (ADR-017 — TASK-IAM-001)
# Production: BETTER_AUTH_SECRET phải lấy từ secret store; BETTER_AUTH_URL phải là HTTPS public URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Danh sách origin phân tách bằng dấu phẩy; production phải khai báo tường minh.
AUTH_ALLOWED_CALLBACK_ORIGINS="http://localhost:3000,vexenhanh://,vexenhanh-operator://"

# JWT access RS256 (private key: PKCS#8 PEM raw hoặc base64; production bắt buộc)
# Dev để trống private key sẽ sinh keypair ephemeral, token mất hiệu lực sau khi restart.
JWT_ACCESS_PRIVATE_KEY=""
# Reserved cho verifier/JWKS sau này; TokenService hiện chưa đọc biến này.
JWT_ACCESS_PUBLIC_KEY=""
JWT_ACCESS_TTL_SECONDS="900"
JWT_ISSUER="vexenhanh"
REFRESH_TOKEN_TTL_SECONDS="2592000"
# TASK-IAM-004 — BẮT BUỘC trên production/Render: AES-256-GCM key mã hóa TOTP secret.
# Sinh MỘT LẦN rồi lưu vào Render Secret (không commit giá trị thật):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Hoặc: openssl rand -base64 32
# PHẢI giữ nguyên key sau khi account đã enroll MFA; đổi/mất key sẽ khiến TOTP secret cũ không giải mã được.
MFA_ENCRYPTION_KEY=""

# TASK-IAM-006 — web auth cookie mode (Operator OS / Admin). Production BẮT BUỘC cả hai (API từ chối khởi động).
# Exact origin HTTPS của TỪNG app (phân tách dấu phẩy, không `*`, không path); phiên cookie chỉ dùng được từ
# app đúng scope. Để trống ở local → Operator OS http://localhost:3002, Admin http://localhost:3003.
OPERATOR_WEB_ORIGINS=""
ADMIN_WEB_ORIGINS=""
# Khoá HMAC ký CSRF token (base64 32 byte), KHÁC mọi secret khác. Để trống ở local → khoá ngẫu nhiên mỗi lần chạy.
WEB_CSRF_SECRET=""

# OAuth Passenger — v1 chỉ bật Google. `GOOGLE_CLIENT_ID` là Web OAuth client ID;
# Passenger Mobile truyền cùng giá trị qua `--dart-define=GOOGLE_SERVER_CLIENT_ID=...`.
# Client ID được phép nằm ở app; tuyệt đối không đưa GOOGLE_CLIENT_SECRET vào Flutter.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Deferred v1.x: chưa được wire ở v1 hiện tại.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Email OTP — điền key Resend để thử OTP trong dev; thiếu key thì không gửi OTP. Production bắt buộc Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@vexenhanh.com"

# Goong REST API key (ADR-027) — tính khoảng cách/thời gian khi tạo/sửa route. Để trống ở dev → ước lượng
# đường chim bay (không tốn quota). Production BẮT BUỘC (API từ chối khởi động nếu thiếu).
GOONG_API_KEY=""

# Thanh toán hành khách: payOS / MoMo / VNPay / cổng DEMO.
# Điền các biến này vào apps/api/.env.development (local) hoặc Environment của service API + worker.
# Khóa chỉ ở backend; KHÔNG chép vào apps/passenger_mobile/.env* / --dart-define.
# MoMo/VNPay giữ URL SANDBOX tới khi giải quyết OQ-22; khóa phải cùng môi trường với URL.
# Khai đầy đủ nhóm khóa của từng cổng muốn dùng; khai dở nhóm → API từ chối khởi động.
# Production thiếu cả nhóm → cổng đó tắt, tạo payment trả 503.
# BETTER_AUTH_URL ở mục IAM phía trên cũng là origin API dùng nhận IPN: thử cổng bên ngoài cần HTTPS công khai.

# VNPay: điền Terminal ID (vnp_TmnCode) và Secret Key (vnp_HashSecret) do VNPay cấp.
# Khai IPN trên trang quản trị merchant: GET {BETTER_AUTH_URL}/v1/webhooks/payment/vnpay.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# MoMo: điền Partner Code, Access Key, Secret Key của môi trường thử nghiệm.
# MOMO_ENDPOINT là origin, KHÔNG kèm /v2/gateway/api/create (adapter tự nối đường dẫn).
# IPN được gửi kèm từng giao dịch: POST {BETTER_AUTH_URL}/v1/webhooks/payment/momo.
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn"

# Origin web Marketplace truy cập được từ trình duyệt trên điện thoại, KHÔNG kèm path.
# Cả ba cổng đưa khách về {gốc}/bookings/{bookingId}/payment/result; đây không phải IPN/webhook.
PAYMENT_RETURN_BASE_URL="http://localhost:3001"

# payOS (tiền thật, KHÔNG có sandbox): chỉ dùng ở local tới khi giải quyết OQ-22.
# Webhook POST: https://<api-public>/v1/webhooks/payment/payos.
# Thiếu cả ba khóa → PAYOS tắt, không tự chuyển sang giả lập; khai dở khóa → từ chối khởi động.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYOS_API_URL="https://api-merchant.payos.vn"
# DEMO tự bật ở dev/test khi không có khóa payOS. Production cần bật tường minh và chỉ dùng dữ liệu mẫu.
# Không được bật DEMO cùng khóa payOS.
# Dev/test thiếu khóa VNPay/MoMo có cổng giả lập riêng; có khóa payOS thì không bật các fallback này.
PAYMENT_DEMO_ENABLED="false"

# IAM seed — CHỈ local/dev; điền trước khi chạy `pnpm --filter @vexenhanh/api db:seed`.
# Không đặt các biến SEED_* trong production/Render.
SEED_PLATFORM_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
SEED_EMPLOYEE_PASSWORD=""

# ── Kho object công khai (ADR-018, TASK-TRN-009) ──
# Đủ cả năm biến R2 → dùng Cloudflare R2. Để trống cả năm → lưu ổ đĩa local (chỉ dev / test); production bắt buộc.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET=""
# Gốc địa chỉ công khai của bucket (CDN / custom domain), vd https://cdn.vexenhanh.com
R2_PUBLIC_BASE_URL=""
# Thư mục của kho ổ đĩa local, tính từ apps/api. Mặc định .storage/public (giấy tờ KYC ở thư mục anh em .storage/private)
STORAGE_LOCAL_DIR=""
# Bucket private cho giấy tờ KYC (TASK-OPR-001). Production để trống → API giấy tờ trả 503 cho tới khi chốt OQ-21.
R2_PRIVATE_BUCKET=""

# ── Đăng ký nhà xe (TASK-OPR-001) ──
# Push server: FCM service account hoặc APNs signing key, chỉ bật khi cấu hình đủ một nhóm.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_PRIVATE_KEY=""
APNS_TOPIC=""
APNS_SANDBOX="true"

# Hạn dùng link bảo mật của hồ sơ, tính bằng giờ (mặc định 72, tối đa 720).
OPERATOR_APPLICATION_LINK_TTL_HOURS=""
