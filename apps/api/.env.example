# ─────────────────────────────────────────────────────────────────────────────
# Cấu trúc env 2 phần:
#   1) `.env`                                  → chỉ chọn môi trường: NODE_ENV=development|production
#   2) `.env.development` / `.env.production`  → giá trị theo môi trường
# Loader: đọc NODE_ENV (từ `.env` hoặc shell/Render) → nạp `.env.{NODE_ENV}`.
# Precedence (cao→thấp): env thật (shell/Render) > `.env` > `.env.{NODE_ENV}`.
#
# Setup local: tạo `.env` (NODE_ENV=development) + copy phần giá trị dưới → `.env.development`.
# Production THẬT trên Render lấy từ env group + secrets (sync:false) — KHÔNG commit giá trị.
# ─────────────────────────────────────────────────────────────────────────────

# ── đặt ở `.env` ─────────────────────────────────────────────
NODE_ENV="development"

# ── đặt ở `.env.development` / `.env.production` ──────────────
PORT="3000"

# Postgres (Prisma) — operational DB
DATABASE_URL="postgresql://vexenhanh:vexenhanh_dev@localhost:5432/vexenhanh_dev?schema=public"

# Mongo audit (Mongoose, cluster RIÊNG — ADR-011)
MONGODB_AUDIT_URI="mongodb://vexenhanh:vexenhanh_dev@localhost:27017/vexenhanh_audit?authSource=admin"
# Mongo audit production hardening (admin URI chỉ dùng để chạy script, không dùng app runtime)
MONGODB_ADMIN_URI="mongodb://admin:change_me@localhost:27017/admin?authSource=admin"
MONGODB_AUDIT_DB="vexenhanh_audit"
MONGODB_AUDIT_APP_USER="vexenhanh_audit_app"
MONGODB_AUDIT_APP_PASSWORD="change_me"

# Redis / BullMQ (ADR-015 / ADR-016 — FND-004)
REDIS_URL="redis://localhost:6379"
BULLMQ_PREFIX="vexenhanh"
BULL_BOARD_TOKEN="change-me-local"

# Logging (Pino — ADR-026 / FND-006)
LOG_LEVEL="info"

# Observability (ADR-026 — FND-006)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
OTEL_SERVICE_NAME="vexenhanh-api"
