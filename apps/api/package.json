{
  "name": "@vexenhanh/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma --allow-no-models",
    "prisma:studio": "dotenv -e .env.development -- prisma studio --schema prisma/schema.prisma",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma --allow-no-models"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "^11.1.24",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.78.0",
    "ioredis": "^5.11.0",
    "mongoose": "8.24.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "dotenv-cli": "^8.0.0",
    "prisma": "5.22.0"
  }
}
