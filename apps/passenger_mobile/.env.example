# ==============================================================================
# Biến môi trường cho Ứng dụng Hành khách (Flutter - Passenger Mobile)
# Cách sử dụng khi chạy app:
#   flutter run --dart-define-from-file=.env.local
# Hoặc khi build release:
#   flutter build apk --release --dart-define-from-file=.env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Backend (Origin máy chủ API, KHÔNG kèm /v1)
# ------------------------------------------------------------------------------
# - Android Emulator (mặc định): http://10.0.2.2:3000
# - Thiết bị thật cắm USB (sau khi chạy `adb reverse tcp:3000 tcp:3000`): http://127.0.0.1:3000
# - Thiết bị thật cùng mạng Wi-Fi: http://192.168.x.x:3000
# - Production: https://api.vexenhanh.id.vn (hoặc domain triển khai)
API_BASE_URL=http://10.0.2.2:3000

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Messaging (FCM Push Notifications - ADR-020/028, RB-11)
# Nếu thiếu 1 trong 4 biến dưới đây, tính năng Push sẽ tự động tắt an toàn.
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps (Android)
# hoặc lấy từ file google-services.json (current_key & mobilesdk_app_id).
# ------------------------------------------------------------------------------
# Web API Key (bắt đầu bằng AIzaSy...) - trường current_key trong google-services.json
FIREBASE_API_KEY=

# Mobile SDK App ID (dạng 1:<project_number>:android:<hash>) - trường mobilesdk_app_id
FIREBASE_APP_ID=

# Firebase Project Number (Sender ID) - chuỗi số định danh dự án
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Project ID (vd: vexenhanh-local, vexenhanh)
FIREBASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# 3. Google Sign-In (Tùy chọn)
# ------------------------------------------------------------------------------
# Client ID loại "Web application" lấy từ Google Cloud Console (khớp với GOOGLE_CLIENT_ID của API).
# Bỏ trống nếu chưa kích hoạt Google OAuth trên backend.
GOOGLE_SERVER_CLIENT_ID=

# Client ID loại "iOS" lấy từ Google Cloud Console (chỉ áp dụng khi build chạy trên iOS).
GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. Thanh toán (payOS / MoMo / VNPay / DEMO)
# ------------------------------------------------------------------------------
# App gọi API_BASE_URL để tạo payment và lấy trạng thái; không cần khóa cổng trong Flutter.
# Các biến bắt buộc theo cổng được khai trong apps/api/.env.example và điền ở apps/api/.env.development:
# - payOS: PAYOS_CLIENT_ID, PAYOS_API_KEY, PAYOS_CHECKSUM_KEY, PAYOS_API_URL.
# - MoMo: MOMO_PARTNER_CODE, MOMO_ACCESS_KEY, MOMO_SECRET_KEY, MOMO_ENDPOINT.
# - VNPay: VNPAY_TMN_CODE, VNPAY_HASH_SECRET, VNPAY_PAYMENT_URL, VNPAY_API_URL.
# - Dùng chung backend: BETTER_AUTH_URL (origin API/IPN), PAYMENT_RETURN_BASE_URL (origin web kết quả).
# - Cổng thử: PAYMENT_DEMO_ENABLED; không có tiền thật, production mặc định tắt.
# Không thêm những khóa này vào file cấu hình app hoặc --dart-define; chúng chỉ thuộc backend.
