<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Dev gọi API qua `http://` thường: emulator dùng `10.0.2.2` (alias trỏ về
         localhost của máy host), thiết bị thật dùng IP LAN. Từ `targetSdk` 28,
         Android mặc định chặn cleartext, nên nếu không mở thì lời gọi API đầu
         tiên chết với "CLEARTEXT communication to 10.0.2.2 not permitted by
         network security policy" — trông như lỗi mạng chứ không lộ nguyên nhân.

         Đặt ở `src/debug/` nên KHÔNG lọt vào bản release: manifest merger chỉ
         gộp file này khi build biến thể debug. Production đi `https://` và giữ
         nguyên mặc định chặn. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
