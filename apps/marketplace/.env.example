# URL máy chủ API, dùng ở Next.js Server Actions và Server Components.
API_BASE_URL=http://localhost:3000/v1

# Địa chỉ Operator OS và Admin (link "Đăng nhập nhà xe", "Quản trị hệ thống", "Đăng ký nhà xe" ở footer).
NEXT_PUBLIC_OPERATOR_OS_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Khóa Goong Maptiles để hiển thị bản đồ (khác GOONG_API_KEY của API).
# Đặt trong .env.local của Marketplace; đổi giá trị xong phải khởi động lại dev / build lại.
# Bỏ trống: chỉ hiện danh sách điểm dừng.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=
