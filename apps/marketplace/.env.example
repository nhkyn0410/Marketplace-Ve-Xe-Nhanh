# URL máy chủ API, dùng ở Next.js Server Actions và Server Components.
API_BASE_URL=http://localhost:3000/v1

# Địa chỉ Operator OS và Admin (link "Đăng nhập nhà xe", "Quản trị hệ thống", "Đăng ký nhà xe" ở footer).
NEXT_PUBLIC_OPERATOR_OS_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Khóa Goong Maptiles để hiển thị bản đồ (khác GOONG_API_KEY của API).
# Đặt trong .env.local của Marketplace; đổi giá trị xong phải khởi động lại dev / build lại.
# Bỏ trống: chỉ hiện danh sách điểm dừng.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# Số tổng đài CSKH chung của sàn, web và app dùng cùng một số (không đặt biến: mặc định 1900 636 707).
# Bỏ trống: giao diện ẩn số tổng đài và hướng khách sang email hỗ trợ.
NEXT_PUBLIC_SUPPORT_HOTLINE=1900 636 707

# Đăng nhập Google: Client ID loại "Web application" (cùng GOOGLE_CLIENT_ID của API — client ID công khai được).
# Trong Google Cloud Console thêm origin của web (vd http://localhost:3001) vào "Authorized JavaScript origins".
# Bỏ trống: trang đăng nhập chỉ có đăng nhập bằng email.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App Link của app hành khách (cổng thanh toán quay về https://<web>/app/bookings/…, Android mở lại app).
# Web trả /.well-known/assetlinks.json từ hai biến này; bỏ trống: file rỗng, link mở trên web như thường.
# Gói Android (applicationId) và vân tay SHA-256 khóa ký bản build, nhiều khóa ngăn bằng dấu phẩy
# (lấy bằng: keytool -list -v -keystore <file .keystore> | dòng "SHA256:").
ANDROID_APP_PACKAGE=com.vexenhanh.passenger_mobile
ANDROID_APP_CERT_SHA256=
