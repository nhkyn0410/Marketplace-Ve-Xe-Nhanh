{
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API liveness health check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto_Output"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/postgres": {
      "get": {
        "operationId": "AppController_postgres",
        "parameters": [],
        "responses": {
          "200": {
            "description": "PostgreSQL health check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostgresHealthResponseDto_Output"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL is unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
