{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@vexenhanh/api-client": ["./packages/api-client/src/index.ts"],
      "@vexenhanh/types": ["./packages/types/src/index.ts"],
      "@vexenhanh/ui": ["./packages/ui/src/index.ts"],
      "@vexenhanh/utils": ["./packages/utils/src/index.ts"]
    }
  }
}
