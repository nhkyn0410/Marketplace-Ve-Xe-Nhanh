{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/ai-journal.mjs", "session-start"],
            "timeout": 15,
            "statusMessage": "Chuẩn bị nhật ký AI..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/ai-journal.mjs", "stop"],
            "timeout": 20,
            "statusMessage": "Kiểm tra nhật ký AI..."
          }
        ]
      }
    ]
  }
}
